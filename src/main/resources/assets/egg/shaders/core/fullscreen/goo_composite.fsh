#version 330

// Композит «слизи»: превращает размытое поле в СЛИТНОЕ тело с плавными перемычками.
//
// Весь фокус — резкий порог ПОСЛЕ сильного размытия. Само по себе размытие даёт дымку, у которой
// края всегда тают, и сколько ни крути радиус, отдельные части так и остаются отдельными. А порог
// по размытому полю склеивает всё, что оказалось выше него: две близкие детали сливаются
// перемычкой ровно там, где их размытые ореолы сложились, — та самая органика натёкшей капли.
//
// Гало берём НИЖЕ порога: там, где тела уже нет, но поле ещё есть. Поэтому свечение не отдельный
// проход, а естественное продолжение той же величины.

uniform sampler2D Sampler0;   // размытое поле, a — плотность

in vec2 texCoord0;
in vec4 tint;                 // rgb — запасной цвет, a — общая непрозрачность

out vec4 fragColor;

// Порог тела в долях плотности поля. Ниже — «слишком жидко», выше — сплошная масса.
const float CORE = 0.42;
// Ширина перехода у кромки. Узкая даёт резиновый силуэт, широкая размазывает обратно в дымку.
const float EDGE = 0.13;
// С какой плотности начинается гало. Низкий порог намеренно: широкое мягкое свечение
// ложится на соседние блоки, и знак выглядит подсвечивающим всё вокруг, а не вырезанным из кадра.
const float HALO = 0.015;
void main() {
    vec4 sampled = texture(Sampler0, texCoord0);
    float field = sampled.a;
    if (field <= 0.002) discard;

    // Цвет берём ИЗ ПОЛЯ, а не из тинта. Тинт один на весь проход, и окрашивая им всё, мы теряли
    // перелив вдоль шнура: узлы несут разный цвет, поле его размывает и хранит, а единый тинт
    // затирал результат в одноцветную массу. Капча накоплена аддитивно, поэтому rgb делим
    // на плотность — иначе плотные места выглядели бы пересвеченными.
    vec3 base = field > 0.004 ? clamp(sampled.rgb / field, 0.0, 1.0) : tint.rgb;

    float body = smoothstep(CORE - EDGE, CORE + EDGE, field);
    float halo = smoothstep(HALO, CORE, field) * (1.0 - body);

    // Внутри тела чуть уводим в белое — сердцевина читается подсвеченной изнутри, а не залитой
    // ровной краской. Немного: на половине белого весь знак становился бесцветным.
    vec3 color = mix(base, vec3(1.0), body * body * 0.25);
    float alpha = (body + halo * 0.75) * tint.a;
    if (alpha <= 0.003) discard;

    // Premultiplied: бленд композита — ONE / ONE_MINUS_SRC_ALPHA.
    fragColor = vec4(color * alpha, alpha);
}
