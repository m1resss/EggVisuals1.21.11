#version 330

// Преломление вокруг шнура знака. В отличие от core/world/entity_warp этот проход НЕ использует шум:
// направление смещения берётся из САМОЙ маски, поэтому искажение привязано к форме шнура, а не живёт
// собственной жизнью в экранных координатах. Шумовой вариант на тонкой полосе читался как грязь —
// рябь шла поперёк неё там, где ей полагалось идти вдоль.

uniform sampler2D Sampler0;   // резкая копия кадра
uniform sampler2D Sampler1;   // размытая маска шнура, a = вес

// Блок-черновик на восемь float, общий с пламенем и rim-glow: каждый композит занимает свои слоты
// и игнорирует остальные. Нам нужен один — матовость. Порядок и размер обязаны совпадать с
// SadnesFlameUniform, иначе std140-смещения разъедутся.
// Комментарии к полям вынесены наружу: внутри блока их не переваривает конвертер GLSL у VulkanMod.
//   Frost — сила матовости 0..1
layout(std140) uniform SadnesFlame {
    float Frost;
    float Unused1;
    float Unused2;
    float Unused3;
    float Unused4;
    float Unused5;
    float Unused6;
    float Unused7;
};

in vec2 texCoord0;
// rgb — ПРОФИЛЬ окраски тремя отсчётами (ось / середина / кромка), уже с ползунком; a — сила
// искажения 0..1. Сам цвет стекла приходит не отсюда, а из rgb маски: там он несёт перелив вдоль
// кольца, а вершинного цвета на всё сразу не хватило бы.
in vec4 tint;

out vec4 fragColor;

// Откуда падает свет на шнур: наискось сверху-слева и ПОЛОГО. Пологий свет — принципиально: с
// отвесным макушка сечения освещена целиком, и объём вырождается в равномерное пятно по всей
// полосе. При пологом разница между склонами и есть то, что читается объёмом.
const vec3 LIGHT = vec3(-0.55, 0.83, 0.32);

// СЛИЯНИЕ. Размытие складывает поля соседних колец, поэтому у сошедшихся кромками шнуров сумма
// поднимается выше, чем у каждого по отдельности, и между ними наливается перемычка — как у двух
// сошедшихся капель. Плавность бесплатная: поле непрерывное, перемычка растёт по мере сближения и
// тает вместе с гаснущим кольцом.
//
// Усиление с клампом, а НЕ порог. Порог (smoothstep до плато) выглядит соблазнительно — он режет
// силуэт чётко, — но плато по определению имеет нулевой градиент, а вся эта штука преломляет
// картинку ИМЕННО градиентом. С плато смещать становится нечем: искажение пропадает везде, кроме
// двухпиксельной кромки. Здесь купол сечения остаётся куполом, клампится только самая макушка.
const float FIELD_GAIN = 1.15;

// МАТОВОСТЬ. Стекло не только гнёт картинку, но и размывает её под собой — полосу видно именно
// поэтому: сама она прозрачная, просто за ней всё смазано. Смещение одно этого не даёт: вдали оно
// падает до пары пикселей и знак пропадает, а смаз читается при любой ширине полосы. Сила приходит
// ползунком в Frost.
const int FROST_TAPS = 8;

float shape(float weight) {
    return clamp(weight * FIELD_GAIN, 0.0, 1.0);
}

// Отсчёты идут по спирали, а не по окружности: кольцо оставляет незакрытой середину и смаз выходит
// «пончиком». Угол крутим от позиции пикселя — одинаковый рисунок отсчётов на всех фрагментах дал
// бы регулярный муар, а сбитый ломается в равномерное матовое зерно.
vec3 frosted(vec2 uv, float radius) {
    vec3 sum = texture(Sampler0, clamp(uv, 0.0, 1.0)).rgb;
    if (radius < 0.35) return sum;

    vec2 texel = 1.0 / vec2(textureSize(Sampler0, 0));
    float angle = fract(sin(dot(uv, vec2(12.9898, 78.233))) * 43758.5453) * 6.2831853;
    for (int i = 0; i < FROST_TAPS; i++) {
        float turn = angle + float(i) * (6.2831853 / float(FROST_TAPS));
        float step = radius * sqrt((float(i) + 0.5) / float(FROST_TAPS));
        sum += texture(Sampler0, clamp(uv + vec2(cos(turn), sin(turn)) * step * texel, 0.0, 1.0)).rgb;
    }
    return sum / float(FROST_TAPS + 1);
}

float field(vec2 uv) {
    return shape(texture(Sampler1, uv).a);
}

// Профиль окраски поперёк шнура: 0 — ось, 1 — кромка. Кривая приходит тремя отсчётами, между ними
// идём smoothstep'ом — на стыке в середине не остаётся излома, и профиль читается сплошной кривой.
float profile(float across) {
    return across < 0.5
            ? mix(tint.r, tint.g, smoothstep(0.0, 1.0, across * 2.0))
            : mix(tint.g, tint.b, smoothstep(0.0, 1.0, across * 2.0 - 1.0));
}

void main() {
    vec4 raw = texture(Sampler1, texCoord0);
    float mask = shape(raw.a);
    if (mask <= 0.004 || tint.a <= 0.002) discard;   // кадр за пределами тела не трогаем вовсе

    vec2 texel = 1.0 / vec2(textureSize(Sampler1, 0));
    // Градиент поля = наклон «стекла»: у оси он нулевой, на склонах смотрит наружу. Берём его уже
    // ПОСЛЕ усиления, поэтому преломление идёт по слитому силуэту, а не по каждому кольцу отдельно.
    float left  = field(texCoord0 - vec2(texel.x, 0.0));
    float right = field(texCoord0 + vec2(texel.x, 0.0));
    float down  = field(texCoord0 - vec2(0.0, texel.y));
    float up    = field(texCoord0 + vec2(0.0, texel.y));
    vec2 slope = vec2(right - left, up - down);
    float steep = length(slope);

    // Смещаем ПО САМОМУ наклону, а не по его направлению. Нормированное направление на гребне
    // разворачивается на 180° через ноль: картинка по обе стороны от оси уезжала в разные стороны,
    // и ровно на месте шнура оставался шов — тонкая линия, которой тут быть не должно. Сырой наклон
    // гаснет к оси сам, поэтому полоса преломления остаётся монолитной.
    // Смещение считаем в ПИКСЕЛЯХ и только потом переводим в UV. Наивный сдвиг прямо в UV тянул бы
    // по X сильнее, чем по Y, ровно во столько раз, во сколько окно шире своей высоты, — искажение
    // растягивалось бы вместе с окном. 0.5 — доля высоты кадра на полной силе; сама сила приходит
    // от экранной толщины шнура, поэтому масштаб эффекта живёт в мире, а не в пикселях экрана.
    float pixels = tint.a * 0.5 * float(textureSize(Sampler1, 0).y);
    vec2 offset = slope * pixels * texel;

    // Хроматическая аберрация: каналы преломляются с разной силой, как в настоящей линзе. Сильнее
    // всего у кромки, где стекло круче — в середине разъезда почти нет. Доля маленькая намеренно:
    // на заметном разъезде кайма сама читается как нарисованная цветная линия.
    float dispersion = 1.0 + 0.10 * min(steep * 8.0, 1.0);
    vec3 color;
    color.r = texture(Sampler0, clamp(texCoord0 + offset * dispersion, 0.0, 1.0)).r;
    color.g = texture(Sampler0, clamp(texCoord0 + offset, 0.0, 1.0)).g;
    color.b = texture(Sampler0, clamp(texCoord0 + offset / dispersion, 0.0, 1.0)).b;

    // Толщина стекла под пикселем, в текселях: у купола отношение высоты к наклону на скате и есть
    // его полуширина. У самой оси наклон обращается в ноль, поэтому потолок обязателен — там стекло
    // и правда самое толстое, дальше расти ему незачем. Величина мировая по построению (купол
    // сжимается вместе с полосой), так что смаз уезжает вдаль вместе со знаком.
    float thickness = min(mask / max(steep, 1.0e-4), 48.0);
    if (Frost > 0.002) color = mix(color, frosted(texCoord0 + offset, thickness * 0.5 * Frost), mask * Frost);

    // ── Объём ────────────────────────────────────────────────────────────────────────────────
    // Нормаль сечения строим из САМОЙ плотности: у оси она смотрит вверх, к кромке заваливается в
    // сторону — ровно как у круглого шнура. Плотность и есть высота стекла, поэтому в объём не
    // входит никакой масштаб и он одинаков на любой дистанции. Плоская подмешка цвета вместо этого
    // читалась наклейкой: у стекла не было ни светлой стороны, ни тёмной.
    vec2 flank = steep > 1.0e-5 ? slope / steep : vec2(0.0);
    vec3 normal = normalize(vec3(-flank * sqrt(max(0.0, 1.0 - mask * mask)), max(mask, 0.2)));
    float lambert = clamp(dot(normal, normalize(LIGHT)), 0.0, 1.0);
    // Кривая CIRC_OUT (та же, что в util Easings): свет набирается сразу и мягко доходит до
    // максимума, отчего сечение читается круглым. Линейный подъём давал ровную заливку.
    float lit = sqrt(max(0.0, 1.0 - (lambert - 1.0) * (lambert - 1.0)));

    // Цвет знака лежит в rgb маски, домноженный там на её же альфу, — делением возвращаем сам тон.
    vec3 tone = clamp(raw.rgb / max(raw.a, 1.0e-4), 0.0, 1.0);
    // Стекло только ФИЛЬТРУЕТ картинку — ничего не добавляет поверх неё. Аддитивный блик, который
    // тут был, и превращал знак вдали в светящееся пятно: на десяти блоках всё сечение занимает
    // пяток пикселей, добавка ложится на них целиком, а размытие растягивает её в кляксу. У
    // фильтра такой болезни нет по построению — он не может стать ярче того, что под ним, поэтому
    // вдали знак просто уменьшается вместе с кольцом. Объём даёт разница склонов: теневой глубже,
    // освещённый светлее.
    vec3 glass = color * tone * mix(0.68, 1.22, lit);

    // Вся окраска целиком уходит под профиль: на нуле ползунка он нулевой, и в кадре остаётся
    // чистое преломление — ни цвета, ни объёма, ни блика.
    color = mix(color, glass, profile(1.0 - mask));

    // Альфа = вес поля: подмена полная там, где стекло плотное, и сходит на нет к кромке. Сэмплится
    // резкая копия, поэтому при нулевом смещении результат совпадает с кадром — шва нет.
    fragColor = vec4(color, clamp(mask * 1.2, 0.0, 1.0));
}
