#version 330

// Сечение неоновой трубки целиком. Геометрия ленты вдвое шире видимого стекла, поэтому силуэт
// задаёт спад яркости, а не кромка полигона: край антиалиасится сам собой на любом угле и на любой
// дистанции, а стыки сегментов приходятся туда, где вклад уже нулевой.
in vec4 vertexColor;
in vec2 tube;   // x — поперёк ленты [-1..1], y — накал ядра [0..1]

out vec4 fragColor;

// Радиус стеклянной трубки в долях полуширины ленты; дальше — свободное свечение.
const float GLASS = 0.42;
// Сигма добела-белой нити внутри трубки, в тех же долях: масштабируется вместе с глифом, в отличие
// от пиксельного ядра молний, которое на широком проходе вело себя иначе.
const float FILAMENT = 0.15;
// Крутизна хвоста за стеклом. Экспонента вместо степенного спада: у настоящего неона свечение
// уходит длинным низким шлейфом, а pow даёт плоскую и дешёвую на вид заливку.
const float BLEED = 4.6;

void main() {
    float d = abs(tube.x);
    // Окно гасит вклад ровно на геометрической кромке ленты, причём с нулевой производной —
    // никакого видимого обреза свечения.
    float window = 1.0 - d * d;
    if (window <= 0.0) discard;

    float filament = exp(-(d * d) / (2.0 * FILAMENT * FILAMENT)) * tube.y;
    float plasma = 1.0 - smoothstep(GLASS * 0.35, GLASS, d);
    float bleed = exp(-max(d - GLASS, 0.0) * BLEED / (1.0 - GLASS));

    // Ядро уводим почти в белое, но 8% оттенка оставляем: чистый белый на аддитиве при затухании
    // читается как обесцвеченная линия, а не как остывающий газ.
    vec3 col = mix(vertexColor.rgb, vec3(1.0), filament * 0.92);
    float a = clamp((filament * 1.15 + plasma * 0.5 + bleed * 0.34) * window * vertexColor.a, 0.0, 1.0);
    if (a <= 0.003) discard;

    fragColor = vec4(col, a);
}
